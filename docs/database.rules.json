{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "$code": {
        ".read": "$code.matches(/^[A-Z0-9]{6}$/)",
        ".write": "!data.exists() && $code.matches(/^[A-Z0-9]{6}$/)",
        ".validate": "newData.hasChildren(['players'])",
        "players": {
          "$p": {
            ".write": "$p === 'p0' || $p === 'p1'",
            ".validate": "newData.hasChildren(['name'])",
            "name": { ".validate": "newData.isString() && newData.val().length <= 16" },
            "seen": { ".validate": "newData.isNumber()" },
            "$other": { ".validate": false }
          }
        },
        "log": {
          "$i": {
            ".write": "!data.exists()",
            ".validate": "$i.matches(/^m[0-9]{4}$/) && newData.hasChild('k')"
          }
        }
      }
    }
  }
}
